{
  "name": "dayhub",
  "productName": "YD",
  "version": "0.2.21",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0"
  },
  "description": "YD · Your Day —— 本地优先的日程中枢，离线可用的 Windows 课表、待办与提醒",
  "author": "YD",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "fixtures:build": "node scripts/build-fixtures.mjs",
    "assets:companion": "python scripts/companion-assets.py",
    "assets:icon": "python scripts/prepare-app-icon.py",
    "assets:check": "node scripts/verify-brand-assets.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:vs2": "node scripts/verify-vs2.cjs",
    "dist": "npm run build && npm run assets:check && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "cn.dayhub.desktop",
    "productName": "YD",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "native/ocr.ps1",
      "node_modules/sql.js/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "native/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "brand/exports/yd.ico",
      "artifactName": "YD-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "YD",
      "installerIcon": "brand/exports/yd.ico",
      "uninstallerIcon": "brand/exports/yd.ico",
      "installerHeader": "brand/installer/header.bmp",
      "installerSidebar": "brand/installer/sidebar.bmp",
      "uninstallerSidebar": "brand/installer/sidebar.bmp"
    }
  }
}
